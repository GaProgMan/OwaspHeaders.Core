<Project>

  <!-- Shared MSBuild properties for every project in this repository.
       This file is imported *before* each csproj, so any individual project
       can still override anything set here. -->

  <PropertyGroup Label="Build settings">
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Nullable is on for every project, but each file which has not yet been
         reviewed for null-safety opts out with a #nullable disable directive on
         its first line. Deleting a file's directive is the review, so
         `grep -rl '#nullable disable' src tests` is the work left. See issue #233. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Versioning and authorship">
    <!-- Only src is packed and published, but keeping the version here means a
         release is a single-line change rather than a hand-synced pair. -->
    <Version>11.0.0</Version>
    <Authors>Jamie Taylor</Authors>
    <Company>RJJ Software Ltd</Company>
    <Copyright>Copyright (c) Jamie Taylor / RJJ Software Ltd</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
