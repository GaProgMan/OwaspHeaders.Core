<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <!-- Deliberately local to this project: src and tests are not yet
             nullable-annotated, so these cannot be hoisted to
             /Directory.Build.props without a wider piece of work. -->
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11"/>
        <PackageReference Include="Scalar.AspNetCore" Version="2.14.14"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\OwaspHeaders.Core.csproj" />
    </ItemGroup>

  <ItemGroup>
    <!-- ignores this csproj from code coverage. This project is simply an example
         ASP .NET Core WebAPI which shows off how to use the middleware. As such, 
         it should not be included in code coverage stats for the middleware.
     -->
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>

</Project>
