<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <Description>A Unit Test project (using xunit) for the OwaspHeaders.Core project</Description>
    <AssemblyName>OwaspHeaders.Core.Tests</AssemblyName>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Microsoft Testing Platform runner extensions: these replace the VSTest
         trio of Microsoft.NET.Test.Sdk, xunit.runner.visualstudio and
         coverlet.collector. See issue #226. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.0" />
    
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.6.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\OwaspHeaders.Core.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- ignores this csproj from code coverage -->
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>
  
</Project>